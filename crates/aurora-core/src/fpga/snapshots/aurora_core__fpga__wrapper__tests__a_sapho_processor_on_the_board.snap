// Generated by Lace from fpga.json: the board top of Placa de teste, which
// connects the ports of proc to the board signals.
// Lace writes it again on every build: do not edit.
`default_nettype none

module aurora_board_top (
    input  wire CLOCK_50,
    input  wire [1:0] KEY,
    input  wire [3:0] SW,
    output wire [5:0] LED,
    output wire [1:0] HEX0
);
    wire [15:0] aurora_out;
    wire aurora_req_in;
    wire aurora_out_en;

    proc u_top (
        .clk(CLOCK_50),
        .rst(~KEY[0]),
        .in({12'b0, SW[3:0]}),
        .out(aurora_out),
        .req_in(aurora_req_in),
        .out_en(aurora_out_en)
    );

    assign LED = {aurora_out_en, 1'b0, aurora_out[3:0]};
    assign HEX0 = ~aurora_out[1:0];
endmodule

`default_nettype wire
