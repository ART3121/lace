{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FpgaBoardsReport",
  "description": "`aurora fpga boards`: as placas conhecidas, ou a pedida.",
  "type": "object",
  "properties": {
    "boards": {
      "description": "As placas, com o FPGA, o cabo e os sinais com os pinos.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Board"
      }
    }
  },
  "required": [
    "boards"
  ],
  "$defs": {
    "Board": {
      "description": "Uma placa.",
      "type": "object",
      "properties": {
        "id": {
          "description": "O identificador, usado no `fpga.json` e na CLI (`de2-115`).",
          "type": "string"
        },
        "name": {
          "description": "O nome para mostrar (`Terasic DE2-115`).",
          "type": "string"
        },
        "source": {
          "description": "De onde vieram os pinos: o manual, a versão e as tabelas.",
          "type": "string"
        },
        "device": {
          "description": "O FPGA.",
          "$ref": "#/$defs/Device"
        },
        "jtag": {
          "description": "A gravação pela USB da placa.",
          "$ref": "#/$defs/Jtag"
        },
        "signals": {
          "description": "Os sinais da placa ligados ao FPGA.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/BoardSignal"
          }
        },
        "peripherals": {
          "description": "O que cada sinal é na placa (chaves, LEDs, displays, tela), para a\nplaca virtual desenhá-los e simulá-los. Um sinal fora daqui também\nvai para a placa; só não aparece na placa virtual.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Peripheral"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "source",
        "device",
        "jtag",
        "signals"
      ]
    },
    "Device": {
      "description": "O FPGA de uma placa.",
      "type": "object",
      "properties": {
        "family": {
          "description": "A família, como o Quartus a escreve no `.qsf` (`Cyclone IV E`).",
          "type": "string"
        },
        "part": {
          "description": "O modelo, como no `.qsf` (`EP4CE115F29C7`).",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "family",
        "part"
      ]
    },
    "Jtag": {
      "description": "Como gravar a placa pela USB dela.",
      "type": "object",
      "properties": {
        "cable": {
          "description": "O cabo.",
          "$ref": "#/$defs/Cable"
        },
        "position": {
          "description": "A posição do FPGA na cadeia JTAG, a partir de 1. Na DE10-Nano o FPGA\nvem depois do processador ARM (HPS).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "openfpgaloader": {
          "description": "O nome da placa no openFPGALoader (`-b`), se ele a conhece.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "cable",
        "position"
      ]
    },
    "Cable": {
      "description": "O cabo de gravação embutido na placa.",
      "oneOf": [
        {
          "description": "USB-Blaster (FT245 e um CPLD).",
          "type": "string",
          "const": "usb-blaster"
        },
        {
          "description": "USB-Blaster II (EZ-USB FX2). O openFPGALoader só o usa com o firmware\n`blaster_6810.hex`, que vem com o Quartus.",
          "type": "string",
          "const": "usb-blasterII"
        }
      ]
    },
    "BoardSignal": {
      "description": "Um sinal da placa: um fio (`CLOCK_50`) ou um barramento (`SW`), com um\npino por bit.",
      "type": "object",
      "properties": {
        "name": {
          "description": "O nome, como no manual (`KEY`, `LEDR`).",
          "type": "string"
        },
        "direction": {
          "description": "A direção.",
          "$ref": "#/$defs/SignalDirection"
        },
        "pins": {
          "description": "Os pinos, do bit 0 em diante (`PIN_Y2`).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "io_standard": {
          "description": "O padrão de I/O, como no `.qsf` (`3.3-V LVTTL`): um para o sinal\ninteiro ou um por bit, quando os bits ficam em bancos de tensões\ndiferentes.",
          "$ref": "#/$defs/IoStandard"
        },
        "active_low": {
          "description": "Ativo em nível baixo: o botão apertado lê 0, o segmento acende em 0.\nNum sinal de saída, os bits que nada liga ficam no nível inativo.",
          "type": "boolean",
          "default": false
        },
        "clock_mhz": {
          "description": "A frequência, se for um clock.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "description": {
          "description": "O que é, como no manual.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "direction",
        "pins",
        "io_standard",
        "active_low",
        "description"
      ]
    },
    "SignalDirection": {
      "description": "A direção de um sinal da placa, do ponto de vista do FPGA.",
      "oneOf": [
        {
          "description": "Entra no FPGA: clock, botão, chave.",
          "type": "string",
          "const": "input"
        },
        {
          "description": "Sai do FPGA: LED, display.",
          "type": "string",
          "const": "output"
        }
      ]
    },
    "IoStandard": {
      "description": "O padrão de I/O de um sinal.",
      "anyOf": [
        {
          "description": "O mesmo para todos os bits.",
          "type": "string"
        },
        {
          "description": "Um por bit, do bit 0 em diante.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "Peripheral": {
      "description": "Um periférico da placa: o tipo e os sinais dele. A placa virtual simula\ncada um nos pinos, como a placa de verdade os liga ao FPGA.",
      "oneOf": [
        {
          "description": "Chaves deslizantes: o bit fica no valor da chave.",
          "type": "object",
          "properties": {
            "signal": {
              "description": "O sinal de entrada.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "switches"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "signal"
          ]
        },
        {
          "description": "Botões: o bit muda enquanto o botão está apertado (vai a 0 num sinal\nativo em baixo, como os KEY das placas da Terasic).",
          "type": "object",
          "properties": {
            "signal": {
              "description": "O sinal de entrada.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "buttons"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "signal"
          ]
        },
        {
          "description": "LEDs, um por bit.",
          "type": "object",
          "properties": {
            "signal": {
              "description": "O sinal de saída.",
              "type": "string"
            },
            "color": {
              "description": "A cor dos LEDs.",
              "$ref": "#/$defs/LedColor"
            },
            "kind": {
              "type": "string",
              "const": "leds"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "signal",
            "color"
          ]
        },
        {
          "description": "Displays de 7 segmentos, um sinal por dígito, da esquerda para a\ndireita. Bit 0 é o segmento a, bit 6 o segmento g; um oitavo bit é o\nponto decimal.",
          "type": "object",
          "properties": {
            "digits": {
              "description": "Os dígitos, da esquerda para a direita.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "kind": {
              "type": "string",
              "const": "seven_segment"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "digits"
          ]
        },
        {
          "description": "Saída de vídeo VGA (ou o vídeo paralelo de um transmissor HDMI): a\nplaca virtual remonta a imagem pelos sinais de sincronismo.",
          "type": "object",
          "properties": {
            "red": {
              "description": "O canal vermelho.",
              "type": "string"
            },
            "green": {
              "description": "O canal verde.",
              "type": "string"
            },
            "blue": {
              "description": "O canal azul.",
              "type": "string"
            },
            "hsync": {
              "description": "O sincronismo horizontal.",
              "type": "string"
            },
            "vsync": {
              "description": "O sincronismo vertical.",
              "type": "string"
            },
            "blank": {
              "description": "O vídeo ativo (`VGA_BLANK_N`, `DE`), se a placa tem.",
              "type": [
                "string",
                "null"
              ]
            },
            "clock": {
              "description": "O relógio de pixel que o projeto entrega ao conversor\n(`VGA_CLK`), se a placa tem.",
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "type": "string",
              "const": "vga"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "red",
            "green",
            "blue",
            "hsync",
            "vsync"
          ]
        },
        {
          "description": "Teclado PS/2: o projeto recebe os quadros do teclado nos dois fios.",
          "type": "object",
          "properties": {
            "clock": {
              "description": "O relógio do teclado (entrada do FPGA).",
              "type": "string"
            },
            "data": {
              "description": "O dado do teclado (entrada do FPGA).",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "ps2"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "clock",
            "data"
          ]
        },
        {
          "description": "Porta serial (UART).",
          "type": "object",
          "properties": {
            "tx": {
              "description": "O que o projeto transmite (saída do FPGA).",
              "type": "string"
            },
            "rx": {
              "description": "O que o projeto recebe (entrada do FPGA), se a placa liga.",
              "type": [
                "string",
                "null"
              ]
            },
            "baud": {
              "description": "A velocidade padrão, em bits por segundo.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "uart"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "tx",
            "baud"
          ]
        }
      ]
    },
    "LedColor": {
      "description": "A cor de um LED.",
      "oneOf": [
        {
          "description": "Vermelho.",
          "type": "string",
          "const": "red"
        },
        {
          "description": "Verde.",
          "type": "string",
          "const": "green"
        },
        {
          "description": "Azul.",
          "type": "string",
          "const": "blue"
        },
        {
          "description": "Amarelo.",
          "type": "string",
          "const": "yellow"
        }
      ]
    }
  }
}
