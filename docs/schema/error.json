{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ErrorReport",
  "description": "Qualquer comando que não conseguiu rodar (código de saída 2).",
  "type": "object",
  "properties": {
    "error": {
      "description": "O erro.",
      "$ref": "#/$defs/ErrorInfo"
    }
  },
  "required": [
    "error"
  ],
  "$defs": {
    "ErrorInfo": {
      "description": "Um erro do Lace.",
      "type": "object",
      "properties": {
        "code": {
          "description": "Código estável, em `snake_case` (`no_testbench`, `component_missing`),\nou `cli` para um erro da própria linha de comando.",
          "type": "string"
        },
        "message": {
          "description": "A mensagem, em inglês.",
          "type": "string"
        },
        "hint": {
          "description": "O comando que resolve, quando há um.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "code",
        "message"
      ]
    }
  }
}
