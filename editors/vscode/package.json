{
  "name": "aurora",
  "displayName": "AURORA",
  "description": "Projetos da AURORA no VS Code: as fontes do projeto e o topo do design, pela CLI aurora",
  "version": "0.1.0",
  "publisher": "nipscernlab",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/ART3121/lace.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "verilog",
    "sapho",
    "icarus",
    "fpga",
    "aurora"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "workspaceContains:**/*.spf"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "A extensão roda o aurora sobre os arquivos do projeto."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "configuration": {
      "title": "AURORA",
      "properties": {
        "aurora.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "O executável `aurora`. Vazio: o primeiro `aurora` do `PATH`."
        },
        "aurora.transport": {
          "type": "string",
          "enum": [
            "auto",
            "serve",
            "cli"
          ],
          "default": "auto",
          "scope": "machine",
          "markdownDescription": "Como a extensão fala com o aurora. `auto`: um `aurora serve` em segundo plano quando a versão instalada o tem (0.9.0 ou mais nova), senão um processo por comando. `cli`: sempre um processo por comando (`aurora --json` e `--events`). `serve`: só o `aurora serve`; com uma AURORA mais antiga a extensão fica indisponível."
        },
        "aurora.check.lint": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Toda verificação roda também o `verilator --lint-only` (`aurora check --lint`), que acha larguras que não batem e sinais sem uso."
        },
        "aurora.check.onSave": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Verifica o projeto ao gravar um `.v` ou `.sv` dele. O resultado vai para o painel Problemas e para a barra de status, sem notificação."
        },
        "aurora.add.askForNewFiles": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Pergunta se põe no projeto um `.v` ou `.sv` novo que aparece na pasta dele, fora do `.spf`."
        },
        "aurora.files.followExplorer": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Um arquivo do projeto renomeado ou movido no explorador continua no projeto, no lugar novo (`aurora move --after`), e um apagado sai do projeto (`aurora remove`)."
        },
        "aurora.sim.verilator": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Simula no Verilator, com onda (`aurora sim --verilator`), em vez do Icarus."
        },
        "aurora.sim.timeout": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "Encerra a simulação que passar deste tempo, em segundos (`aurora sim --timeout`). `0`: sem limite; o botão Sim, girando, cancela."
        },
        "aurora.synth.schematic": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Também desenha o esquemático do Graphviz em SVG (`aurora synth --svg`) e o abre. O RTL viewer já mostra o netlist; num design grande o Graphviz pode levar até 60 s."
        },
        "aurora.synth.openViewer": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Abre o RTL viewer, o esquemático interativo da AURORA, depois de cada síntese."
        }
      }
    },
    "languages": [
      {
        "id": "cmm",
        "aliases": [
          "C±",
          "C mais-menos",
          "cmm"
        ],
        "extensions": [
          ".cmm"
        ],
        "configuration": "./languages/cmm.language-configuration.json"
      },
      {
        "id": "sapho-asm",
        "aliases": [
          "Assembly do SAPHO",
          "sapho-asm"
        ],
        "filenamePatterns": [
          "**/Software/*.asm"
        ],
        "configuration": "./languages/sapho-asm.language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cmm",
        "scopeName": "source.cmm",
        "path": "./syntaxes/cmm.tmLanguage.json"
      },
      {
        "language": "sapho-asm",
        "scopeName": "source.sapho-asm",
        "path": "./syntaxes/sapho-asm.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "cmm",
        "path": "./snippets/cmm.json"
      }
    ],
    "commands": [
      {
        "command": "aurora.setTop",
        "title": "Definir como topo",
        "category": "AURORA",
        "icon": "$(target)"
      },
      {
        "command": "aurora.build",
        "title": "Compilar os processadores",
        "category": "AURORA",
        "icon": "$(tools)"
      },
      {
        "command": "aurora.buildProcessor",
        "title": "Compilar o processador",
        "category": "AURORA",
        "icon": "$(tools)"
      },
      {
        "command": "aurora.newProcessor",
        "title": "Novo processador SAPHO...",
        "category": "AURORA",
        "icon": "$(add)"
      },
      {
        "command": "aurora.configureProcessor",
        "title": "Configurar o processador...",
        "category": "AURORA",
        "icon": "$(settings-gear)"
      },
      {
        "command": "aurora.check",
        "title": "Verificar o projeto",
        "category": "AURORA",
        "icon": "$(checklist)"
      },
      {
        "command": "aurora.checkLint",
        "title": "Verificar o projeto com lint (Verilator)",
        "category": "AURORA"
      },
      {
        "command": "aurora.checkFile",
        "title": "Verificar este arquivo",
        "category": "AURORA",
        "icon": "$(checklist)"
      },
      {
        "command": "aurora.checkProcessor",
        "title": "Verificar o processador",
        "category": "AURORA",
        "icon": "$(checklist)"
      },
      {
        "command": "aurora.sim",
        "title": "Simular o projeto",
        "category": "AURORA",
        "icon": "$(play)"
      },
      {
        "command": "aurora.simFast",
        "title": "Simular o projeto rápido (Verilator, sem onda)",
        "category": "AURORA"
      },
      {
        "command": "aurora.simTestbench",
        "title": "Simular este testbench",
        "category": "AURORA",
        "icon": "$(play)"
      },
      {
        "command": "aurora.simProcessor",
        "title": "Simular o processador",
        "category": "AURORA",
        "icon": "$(play)"
      },
      {
        "command": "aurora.synth",
        "title": "Sintetizar o projeto",
        "category": "AURORA",
        "icon": "$(circuit-board)"
      },
      {
        "command": "aurora.synthProcessor",
        "title": "Sintetizar o processador",
        "category": "AURORA",
        "icon": "$(circuit-board)"
      },
      {
        "command": "aurora.rtlViewer",
        "title": "Abrir o RTL viewer",
        "category": "AURORA",
        "icon": "$(circuit-board)"
      },
      {
        "command": "aurora.wave",
        "title": "Abrir a onda",
        "category": "AURORA",
        "icon": "$(pulse)"
      },
      {
        "command": "aurora.waveProcessor",
        "title": "Abrir a onda do processador",
        "category": "AURORA",
        "icon": "$(pulse)"
      },
      {
        "command": "aurora.waveFile",
        "title": "Abrir no surfer-aurora",
        "category": "AURORA",
        "icon": "$(pulse)"
      },
      {
        "command": "aurora.cancel",
        "title": "Cancelar o que está rodando",
        "category": "AURORA",
        "icon": "$(debug-stop)"
      },
      {
        "command": "aurora.cancelRun",
        "title": "Cancelar",
        "category": "AURORA"
      },
      {
        "command": "aurora.add",
        "title": "Adicionar ao projeto",
        "category": "AURORA",
        "icon": "$(add)"
      },
      {
        "command": "aurora.addTestbench",
        "title": "Adicionar ao projeto como testbench",
        "category": "AURORA"
      },
      {
        "command": "aurora.newFile",
        "title": "Novo arquivo Verilog...",
        "category": "AURORA",
        "icon": "$(new-file)"
      },
      {
        "command": "aurora.remove",
        "title": "Tirar do projeto",
        "category": "AURORA",
        "icon": "$(remove)"
      },
      {
        "command": "aurora.rename",
        "title": "Renomear ou mover...",
        "category": "AURORA",
        "icon": "$(edit)"
      },
      {
        "command": "aurora.moveUp",
        "title": "Subir na ordem de compilação",
        "category": "AURORA",
        "icon": "$(arrow-up)"
      },
      {
        "command": "aurora.moveDown",
        "title": "Descer na ordem de compilação",
        "category": "AURORA",
        "icon": "$(arrow-down)"
      },
      {
        "command": "aurora.moveFirst",
        "title": "Primeiro na ordem de compilação",
        "category": "AURORA"
      },
      {
        "command": "aurora.moveLast",
        "title": "Último na ordem de compilação",
        "category": "AURORA"
      },
      {
        "command": "aurora.newProject",
        "title": "Novo projeto",
        "category": "AURORA",
        "icon": "$(new-folder)"
      },
      {
        "command": "aurora.refresh",
        "title": "Atualizar",
        "category": "AURORA",
        "icon": "$(refresh)"
      },
      {
        "command": "aurora.selectProject",
        "title": "Escolher o projeto ativo",
        "category": "AURORA"
      },
      {
        "command": "aurora.showTools",
        "title": "Mostrar a saída das ferramentas",
        "category": "AURORA",
        "icon": "$(output)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aurora",
          "title": "AURORA",
          "icon": "media/lace.svg"
        }
      ]
    },
    "views": {
      "aurora": [
        {
          "id": "aurora.sources",
          "name": "Fontes"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "aurora.sources",
        "contents": "Procurando o aurora...",
        "when": "aurora.state == checking"
      },
      {
        "view": "aurora.sources",
        "contents": "O executável aurora não foi encontrado.\n[Configurar aurora.path](command:workbench.action.openSettings?%5B%22lace.path%22%5D)\n[Instalar a AURORA](https://github.com/ART3121/lace/blob/main/docs/INSTALL.md)",
        "when": "aurora.state == missing"
      },
      {
        "view": "aurora.sources",
        "contents": "Esta versão do aurora não serve para a extensão. Os detalhes estão na saída AURORA.\n[Configurar aurora.path](command:workbench.action.openSettings?%5B%22lace.path%22%5D)\n[Atualizar a AURORA](https://github.com/ART3121/lace/blob/main/docs/INSTALL.md)",
        "when": "aurora.state == unsupported"
      },
      {
        "view": "aurora.sources",
        "contents": "Esta pasta não tem um projeto da AURORA (.spf).\n[Novo projeto](command:aurora.newProject)",
        "when": "aurora.state == noProject && workspaceFolderCount > 0"
      },
      {
        "view": "aurora.sources",
        "contents": "Nenhuma pasta aberta.\n[Novo projeto](command:aurora.newProject)\n[Abrir pasta](command:vscode.openFolder)",
        "when": "aurora.state == noProject && workspaceFolderCount == 0"
      },
      {
        "view": "aurora.sources",
        "contents": "Este workspace tem mais de um projeto da AURORA.\n[Escolher o projeto ativo](command:aurora.selectProject)",
        "when": "aurora.state == chooseProject"
      },
      {
        "view": "aurora.sources",
        "contents": "O projeto não tem fontes.\n[Novo arquivo Verilog](command:aurora.newFile)",
        "when": "aurora.state == ready"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "aurora.setTop",
          "when": "aurora.feature.setTop && aurora.projectActive && resourceScheme == file && resourceExtname =~ /^\\.s?v$/ && resourceFilename =~ /^(?!(tb|tb_.*|.*_tb)\\.[^.]*$)/i && resourcePath not in aurora.topFiles && resourcePath not in aurora.testbenchFiles"
        },
        {
          "command": "aurora.build",
          "when": "aurora.feature.processors && aurora.projectActive"
        },
        {
          "command": "aurora.buildProcessor",
          "when": "false"
        },
        {
          "command": "aurora.newProcessor",
          "when": "aurora.feature.processors && aurora.projectActive"
        },
        {
          "command": "aurora.configureProcessor",
          "when": "aurora.feature.processors && aurora.projectActive"
        },
        {
          "command": "aurora.check",
          "when": "aurora.feature.check && aurora.projectActive"
        },
        {
          "command": "aurora.checkLint",
          "when": "aurora.feature.check && aurora.projectActive"
        },
        {
          "command": "aurora.checkFile",
          "when": "aurora.feature.check && aurora.projectActive && resourceScheme == file && resourceExtname =~ /^\\.s?v$/"
        },
        {
          "command": "aurora.checkProcessor",
          "when": "false"
        },
        {
          "command": "aurora.sim",
          "when": "aurora.feature.sim && aurora.projectActive"
        },
        {
          "command": "aurora.simFast",
          "when": "aurora.feature.simFast && aurora.projectActive"
        },
        {
          "command": "aurora.simTestbench",
          "when": "aurora.feature.sim && aurora.projectActive && resourceScheme == file && resourcePath in aurora.testbenchFiles"
        },
        {
          "command": "aurora.simProcessor",
          "when": "false"
        },
        {
          "command": "aurora.synth",
          "when": "aurora.feature.synth && aurora.projectActive"
        },
        {
          "command": "aurora.synthProcessor",
          "when": "false"
        },
        {
          "command": "aurora.rtlViewer",
          "when": "aurora.feature.synth && aurora.projectActive"
        },
        {
          "command": "aurora.wave",
          "when": "aurora.feature.wave && aurora.projectActive"
        },
        {
          "command": "aurora.waveProcessor",
          "when": "false"
        },
        {
          "command": "aurora.waveFile",
          "when": "aurora.feature.wave && resourceScheme == file && resourceExtname =~ /^\\.(vcd|fst|ghw)$/i"
        },
        {
          "command": "aurora.add",
          "when": "aurora.feature.add && aurora.projectActive && resourceScheme == file && resourceExtname =~ /^\\.s?v$/ && resourcePath not in aurora.registeredFiles"
        },
        {
          "command": "aurora.addTestbench",
          "when": "aurora.feature.add && aurora.projectActive && resourceScheme == file && resourceExtname =~ /^\\.s?v$/ && resourcePath not in aurora.registeredFiles"
        },
        {
          "command": "aurora.newFile",
          "when": "aurora.feature.add && aurora.projectActive"
        },
        {
          "command": "aurora.remove",
          "when": "aurora.feature.files && aurora.projectActive && resourceScheme == file && resourcePath in aurora.registeredFiles"
        },
        {
          "command": "aurora.rename",
          "when": "false"
        },
        {
          "command": "aurora.moveUp",
          "when": "false"
        },
        {
          "command": "aurora.moveDown",
          "when": "false"
        },
        {
          "command": "aurora.moveFirst",
          "when": "false"
        },
        {
          "command": "aurora.moveLast",
          "when": "false"
        },
        {
          "command": "aurora.newProject",
          "when": "aurora.feature.newProject"
        },
        {
          "command": "aurora.refresh",
          "when": "aurora.state == ready"
        },
        {
          "command": "aurora.cancel",
          "when": "aurora.running"
        },
        {
          "command": "aurora.cancelRun",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "aurora.setTop",
          "when": "aurora.feature.setTop && aurora.projectActive && resourceScheme == file && resourceExtname =~ /^\\.s?v$/ && resourceFilename =~ /^(?!(tb|tb_.*|.*_tb)\\.[^.]*$)/i && resourcePath not in aurora.topFiles && resourcePath not in aurora.testbenchFiles",
          "group": "aurora@1"
        },
        {
          "command": "aurora.checkFile",
          "when": "aurora.feature.check && aurora.projectActive && resourceScheme == file && resourceExtname =~ /^\\.s?v$/",
          "group": "aurora@2"
        },
        {
          "command": "aurora.simTestbench",
          "when": "aurora.feature.sim && aurora.projectActive && resourceScheme == file && resourcePath in aurora.testbenchFiles",
          "group": "aurora@2"
        },
        {
          "command": "aurora.add",
          "when": "aurora.feature.add && aurora.projectActive && resourceScheme == file && resourceExtname =~ /^\\.s?v$/ && resourcePath not in aurora.registeredFiles",
          "group": "aurora@3"
        },
        {
          "command": "aurora.addTestbench",
          "when": "aurora.feature.add && aurora.projectActive && resourceScheme == file && resourceExtname =~ /^\\.s?v$/ && resourcePath not in aurora.registeredFiles",
          "group": "aurora@4"
        },
        {
          "command": "aurora.waveFile",
          "when": "aurora.feature.wave && resourceScheme == file && resourceExtname =~ /^\\.(vcd|fst|ghw)$/i",
          "group": "aurora@5"
        },
        {
          "command": "aurora.newFile",
          "when": "aurora.feature.add && aurora.projectActive && explorerResourceIsFolder",
          "group": "aurora@6"
        },
        {
          "command": "aurora.remove",
          "when": "aurora.feature.files && aurora.projectActive && resourceScheme == file && resourcePath in aurora.registeredFiles",
          "group": "aurora@7"
        }
      ],
      "editor/context": [
        {
          "command": "aurora.setTop",
          "when": "aurora.feature.setTop && aurora.projectActive && resourceScheme == file && resourceExtname =~ /^\\.s?v$/ && resourceFilename =~ /^(?!(tb|tb_.*|.*_tb)\\.[^.]*$)/i && resourcePath not in aurora.topFiles && resourcePath not in aurora.testbenchFiles",
          "group": "aurora@1"
        },
        {
          "command": "aurora.checkFile",
          "when": "aurora.feature.check && aurora.projectActive && resourceScheme == file && resourceExtname =~ /^\\.s?v$/",
          "group": "aurora@2"
        },
        {
          "command": "aurora.simTestbench",
          "when": "aurora.feature.sim && aurora.projectActive && resourceScheme == file && resourcePath in aurora.testbenchFiles",
          "group": "aurora@2"
        },
        {
          "command": "aurora.add",
          "when": "aurora.feature.add && aurora.projectActive && resourceScheme == file && resourceExtname =~ /^\\.s?v$/ && resourcePath not in aurora.registeredFiles",
          "group": "aurora@3"
        },
        {
          "command": "aurora.addTestbench",
          "when": "aurora.feature.add && aurora.projectActive && resourceScheme == file && resourceExtname =~ /^\\.s?v$/ && resourcePath not in aurora.registeredFiles",
          "group": "aurora@4"
        }
      ],
      "editor/title/context": [
        {
          "command": "aurora.setTop",
          "when": "aurora.feature.setTop && aurora.projectActive && resourceScheme == file && resourceExtname =~ /^\\.s?v$/ && resourceFilename =~ /^(?!(tb|tb_.*|.*_tb)\\.[^.]*$)/i && resourcePath not in aurora.topFiles && resourcePath not in aurora.testbenchFiles",
          "group": "aurora@1"
        },
        {
          "command": "aurora.checkFile",
          "when": "aurora.feature.check && aurora.projectActive && resourceScheme == file && resourceExtname =~ /^\\.s?v$/",
          "group": "aurora@2"
        },
        {
          "command": "aurora.add",
          "when": "aurora.feature.add && aurora.projectActive && resourceScheme == file && resourceExtname =~ /^\\.s?v$/ && resourcePath not in aurora.registeredFiles",
          "group": "aurora@3"
        },
        {
          "command": "aurora.remove",
          "when": "aurora.feature.files && aurora.projectActive && resourceScheme == file && resourcePath in aurora.registeredFiles",
          "group": "aurora@4"
        }
      ],
      "view/title": [
        {
          "command": "aurora.newFile",
          "when": "view == aurora.sources && aurora.feature.add && aurora.state == ready",
          "group": "navigation@3"
        },
        {
          "command": "aurora.refresh",
          "when": "view == aurora.sources && aurora.state == ready",
          "group": "navigation@4"
        },
        {
          "command": "aurora.showTools",
          "when": "view == aurora.sources",
          "group": "aurora@2"
        },
        {
          "command": "aurora.selectProject",
          "when": "view == aurora.sources",
          "group": "aurora@3"
        },
        {
          "command": "aurora.newProject",
          "when": "view == aurora.sources && aurora.feature.newProject",
          "group": "aurora@4"
        },
        {
          "command": "aurora.newProcessor",
          "when": "view == aurora.sources && aurora.feature.processors && aurora.state == ready",
          "group": "aurora@1"
        }
      ],
      "view/item/context": [
        {
          "command": "aurora.setTop",
          "when": "view == aurora.sources && aurora.feature.setTop && viewItem =~ /\\.settop(\\.|$)/",
          "group": "inline"
        },
        {
          "command": "aurora.setTop",
          "when": "view == aurora.sources && aurora.feature.setTop && viewItem =~ /\\.settop(\\.|$)/",
          "group": "aurora@1"
        },
        {
          "command": "aurora.add",
          "when": "view == aurora.sources && aurora.feature.add && viewItem =~ /^aurora\\.unregistered/",
          "group": "inline"
        },
        {
          "command": "aurora.add",
          "when": "view == aurora.sources && aurora.feature.add && viewItem == aurora.group.unregistered",
          "group": "inline"
        },
        {
          "command": "aurora.add",
          "when": "view == aurora.sources && aurora.feature.add && viewItem =~ /^aurora\\.unregistered/",
          "group": "aurora@1"
        },
        {
          "command": "aurora.addTestbench",
          "when": "view == aurora.sources && aurora.feature.add && viewItem =~ /^aurora\\.unregistered/",
          "group": "aurora@2"
        },
        {
          "command": "aurora.wave",
          "when": "view == aurora.sources && aurora.feature.wave && viewItem =~ /^aurora\\.testbench\\.selected/",
          "group": "aurora@3"
        },
        {
          "command": "aurora.waveProcessor",
          "when": "view == aurora.sources && aurora.feature.wave && viewItem =~ /^aurora\\.processor/",
          "group": "aurora@3"
        },
        {
          "command": "aurora.checkFile",
          "when": "view == aurora.sources && aurora.feature.check && viewItem =~ /^aurora\\.(design|testbench)(\\.[a-z]+)*\\.verilog$/",
          "group": "aurora@2"
        },
        {
          "command": "aurora.checkProcessor",
          "when": "view == aurora.sources && aurora.feature.check && viewItem =~ /^aurora\\.processor/",
          "group": "aurora@2"
        },
        {
          "command": "aurora.simTestbench",
          "when": "view == aurora.sources && aurora.feature.sim && viewItem =~ /^aurora\\.testbench/",
          "group": "aurora@3"
        },
        {
          "command": "aurora.simProcessor",
          "when": "view == aurora.sources && aurora.feature.sim && viewItem =~ /^aurora\\.processor/",
          "group": "aurora@3"
        },
        {
          "command": "aurora.synthProcessor",
          "when": "view == aurora.sources && aurora.feature.synth && viewItem =~ /^aurora\\.processor/",
          "group": "aurora@3"
        },
        {
          "command": "aurora.rtlViewer",
          "when": "view == aurora.sources && aurora.feature.synth && viewItem =~ /^aurora\\.processor/",
          "group": "aurora@3"
        },
        {
          "command": "aurora.newProcessor",
          "when": "view == aurora.sources && aurora.feature.processors && viewItem == aurora.group.processor",
          "group": "inline"
        },
        {
          "command": "aurora.buildProcessor",
          "when": "view == aurora.sources && aurora.feature.processors && viewItem =~ /^aurora\\.processor/",
          "group": "aurora@3"
        },
        {
          "command": "aurora.configureProcessor",
          "when": "view == aurora.sources && aurora.feature.processors && viewItem =~ /^aurora\\.processor/",
          "group": "aurora@4"
        },
        {
          "command": "aurora.moveUp",
          "when": "view == aurora.sources && aurora.feature.files && viewItem =~ /^aurora\\.(design|testbench)(?!.*\\.first(\\.|$))/",
          "group": "order@1"
        },
        {
          "command": "aurora.moveDown",
          "when": "view == aurora.sources && aurora.feature.files && viewItem =~ /^aurora\\.(design|testbench)(?!.*\\.last(\\.|$))/",
          "group": "order@2"
        },
        {
          "command": "aurora.moveFirst",
          "when": "view == aurora.sources && aurora.feature.files && viewItem =~ /^aurora\\.(design|testbench)(?!.*\\.first(\\.|$))/",
          "group": "order@3"
        },
        {
          "command": "aurora.moveLast",
          "when": "view == aurora.sources && aurora.feature.files && viewItem =~ /^aurora\\.(design|testbench)(?!.*\\.last(\\.|$))/",
          "group": "order@4"
        },
        {
          "command": "aurora.rename",
          "when": "view == aurora.sources && aurora.feature.files && viewItem =~ /^aurora\\.(design|testbench|unregistered)(\\.|$)/",
          "group": "files@1"
        },
        {
          "command": "aurora.remove",
          "when": "view == aurora.sources && aurora.feature.files && viewItem =~ /^aurora\\.(design|testbench)(\\.|$)/",
          "group": "files@2"
        }
      ]
    },
    "colors": [
      {
        "id": "aurora.topForeground",
        "description": "O arquivo de topo na vista Fontes da AURORA.",
        "defaults": {
          "dark": "charts.yellow",
          "light": "charts.yellow",
          "highContrast": "charts.yellow"
        }
      },
      {
        "id": "aurora.simulatedForeground",
        "description": "O testbench simulado na vista Fontes da AURORA.",
        "defaults": {
          "dark": "charts.blue",
          "light": "charts.blue",
          "highContrast": "charts.blue"
        }
      },
      {
        "id": "aurora.builtForeground",
        "description": "Um processador compilado na vista Fontes da AURORA.",
        "defaults": {
          "dark": "charts.green",
          "light": "charts.green",
          "highContrast": "charts.green"
        }
      },
      {
        "id": "aurora.notBuiltForeground",
        "description": "Um processador não compilado na vista Fontes da AURORA.",
        "defaults": {
          "dark": "charts.orange",
          "light": "charts.orange",
          "highContrast": "charts.orange"
        }
      },
      {
        "id": "aurora.unregisteredForeground",
        "description": "Um arquivo fora do projeto na vista Fontes da AURORA.",
        "defaults": {
          "dark": "gitDecoration.untrackedResourceForeground",
          "light": "gitDecoration.untrackedResourceForeground",
          "highContrast": "gitDecoration.untrackedResourceForeground"
        }
      }
    ]
  },
  "scripts": {
    "build": "npm --prefix ../../packages/rtl-viewer run build && node esbuild.mjs",
    "watch": "npm --prefix ../../packages/rtl-viewer run build && node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "compile-tests": "tsc --outDir out",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "npm run compile-tests && mocha --timeout 20000 \"out/test/unit/**/*.test.js\"",
    "test:integration": "npm run compile-tests && npm run build && node out/test/integration/runTest.js",
    "gen:types": "node scripts/gen-aurora-types.mjs",
    "record:fixtures": "node scripts/record-fixtures.mjs",
    "package": "node scripts/package.mjs",
    "vscode:prepublish": "npm --prefix ../../packages/rtl-viewer run build && node esbuild.mjs --production"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.0.0",
    "json-schema-to-typescript": "^16.0.0",
    "mocha": "^11.8.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "overrides": {
    "diff": "^8.0.3",
    "serialize-javascript": "^7.0.5"
  }
}
