    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.0.0",
    "json-schema-to-typescript": "^16.0.0",
    "mocha": "^11.8.0",
